{{define "course-integration-grants"}}
<section class="form-container" aria-labelledby="course-integrations-title">
    <h2 id="course-integrations-title" class="form-container-title">Authorized applications</h2>
    <div class="form-container-body">
        <p class="text-sm text-5 mb-3">Applications listed here can identify this course and read its name, slug and visibility.</p>
        {{if .Data.Error}}
            <p role="alert" class="text-red-600 dark:text-red-400">{{.Data.Error}}</p>
        {{else if .Data.Grants}}
            <div class="grid gap-3">
                {{range .Data.Grants}}
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <span class="min-w-0 overflow-wrap-anywhere font-medium text-3">{{.Integration.Name}}</span>
                        <form method="post" action="/admin/course/{{$.Course.ID}}/integrations/{{.ID}}/revoke">
                            <button type="submit"
                                    class="btn bg-red-500 text-white hover:bg-red-600 dark:bg-red-500 dark:hover:bg-red-600">
                                <i class="fas fa-ban mr-2"></i>Revoke access
                            </button>
                        </form>
                    </div>
                {{end}}
            </div>
        {{else}}
            <p class="text-3">No applications are authorized.</p>
        {{end}}
    </div>
</section>
{{end}}
